{
	"name": "MkDocs",
	"image": "jazzyray.architecture.arch-as-code:0.0.1",
	"forwardPorts": [8000, 9001, "9088:8080"],
	"customizations": {
		"vscode": {
			"extensions": [
				"jebbs.plantuml",
				"DavidAnson.vscode-markdownlint",
				"shd101wyy.markdown-preview-enhanced",
				"darkriszty.markdown-table-prettify",
				"marvhen.reflow-markdown",
				"ciarant.vscode-structurizr",
				"anthropic.claude-code"
			],
			"settings": {
				"markdown-preview-enhanced.plantumlJarPath": "/opt/plantuml/plantuml.jar",
				"terminal.integrated.defaultProfile.linux": "zsh"
			}
		}	
	},
	"features": {
		"ghcr.io/devcontainers/features/node:2.1.1": {},
		"ghcr.io/devcontainers/features/powershell:latest": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
    	"ghcr.io/devcontainers/features/aws-cli:1": {}
	},
	"remoteEnv": {
    	"ANTHROPIC_BASE_URL": "http://host.docker.internal:8033",
		"ANTHROPIC_AUTH_TOKEN": "llama.cpp",
    	"model": "gemma-41-2B",
    	"GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    	"AWS_ACCESS_KEY_ID": "${localEnv:AWS_ACCESS_KEY_ID}",
    	"AWS_SECRET_ACCESS_KEY": "${localEnv:AWS_SECRET_ACCESS_KEY}",
    	"AWS_DEFAULT_REGION": "${localEnv:AWS_DEFAULT_REGION}"
  },
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code"
}
